# Скопируйте в .env:  cp .env.example .env
# .env добавлен в .gitignore — реальные пароли в Git не попадают.
# Приложение читает .env автоматически, если установлен python-dotenv
# (он есть в requirements.txt). Без него используйте export / $env:.

# --- Обязательно для продакшена ---
# Длинный случайный ключ. НЕ меняйте между деплоями: иначе сессии и уже
# отправленные ссылки подтверждения станут недействительными.
SECRET_KEY=replace-with-a-long-random-secret
# Публичный адрес сайта (с https://). Подставляется в ссылку из письма.
APP_BASE_URL=https://zooportal.ru
# DATABASE_URL=sqlite:///maison_patte.db

# --- SMTP ---
# Без SMTP_HOST включается dev-режим и письма НЕ отправляются.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none (локальный тестовый сервер без TLS)
SMTP_SECURITY=starttls
SMTP_USER=your-account@gmail.com
# Для Gmail нужен «пароль приложения», а не обычный пароль аккаунта.
SMTP_PASSWORD=
# Должен совпадать с аккаунтом или быть разрешённым алиасом домена.
SMTP_FROM=no-reply@zooportal.ru
SMTP_TIMEOUT=10

# Принудительный dev-режим даже при настроенном SMTP (только для отладки):
# EMAIL_DEV_MODE=1
